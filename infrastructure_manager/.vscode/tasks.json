{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run terraform container",
      "type": "shell",
      "command": "docker-compose run --rm terraform apply -var=\"server_count=1\" -auto-approve",
      "options": { "cwd": "${workspaceFolder}/terraform" },
      "presentation": { "panel": "new" }
    },
    {
      "label": "Run management.main",
      "type": "shell",
      "command": "powershell -Command \"& { . ${workspaceFolder}\\.venv\\Scripts\\Activate.ps1; python -m management.main }\"",
      "dependsOn": ["Run terraform container"],
      "dependsOrder": "sequence",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "panel": "new" }
    },
    {
      "label": "Run monitoring.main",
      "type": "shell",
      "command": "powershell -Command \"& { . ${workspaceFolder}\\.venv\\Scripts\\Activate.ps1; python -m monitoring.main }\"",
      "dependsOn": ["Run terraform container"],
      "dependsOrder": "sequence",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "panel": "new" }
    },
    {
      "label": "Run All",
      "dependsOn": ["Run management.main", "Run monitoring.main"],
      "dependsOrder": "parallel"
    }
  ]
}
